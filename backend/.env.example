PORT=3333
JWT_SECRET=troque-este-valor-por-um-segredo-forte
DB_PATH=./animeflix.db

# usado só por "npm run import:jikan" — quantas páginas (25 itens cada)
# buscar por tipo de anime/mangá. 40 = até 1.000 por tipo (~5.000 animes
# e ~5.000 mangás no total). Aumente com cuidado: a API pública tem
# limite de requisições, e valores muito altos levam bastante tempo
# pra rodar (com 40, algo entre 15 e 30 minutos).
JIKAN_PAGINAS_POR_TIPO=40
