PORT=3333
JWT_SECRET=troque-este-valor-por-um-segredo-forte
DB_PATH=./animeflix.db

# usado só por "npm run import:jikan" — quantas páginas (25 itens cada)
# buscar por tipo de anime/mangá. 20 = até 500 por tipo (~2.500 animes e
# ~2.500 mangás no total, cobrindo todos os tipos). Aumente com cuidado:
# a API pública tem limite de requisições, e valores muito altos levam
# bastante tempo pra rodar.
JIKAN_PAGINAS_POR_TIPO=20
